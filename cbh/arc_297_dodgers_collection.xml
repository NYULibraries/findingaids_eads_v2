ositories/3/archival_objects/436580</unitid><unitdate datechar="creation" normal="1943/1943">1943</unitdate><container altrender="Large Flat Box" id="aspace_eaad5ada040fa0e75b254bdc820ee277" label="Mixed Materials" type="Box">6</container></did><scopecontent id="aspace_29da467fa5b64eb39282a761aab16402"><head>Scope and Contents</head><p>Walter O'Malley and Branch Rickey pictured at a dinner table among a group of men. Taken October 1943.</p></scopecontent></c><c id="aspace_ref18_tsx" level="file"><did><unittitle>"A World Series Remembrance: The Brooklyn Dodgers vs. The New York Yankees, 1947" lithograph by Jim Annis</unittitle><unitid type="aspace_uri">/repositories/3/archival_objects/21941</unitid><unitdate datechar="creation" normal="2002/2002" type="inclusive">2002</unitdate><container id="aspace_a9adeacb4e73299935d8b94148ec30ee" label="Graphic Materials" type="Folder">Flat File</container></did></c></c><c id="aspace_ref63_uk8" level="series"><did><unittitle>Series 5: Jackie Robinson Conference</unittitle><unitid type="aspace_uri">/repositories/3/archival_objects/21942</unitid><unitdate datechar="creation" normal="1997/1997" type="inclusive">1997</unitdate></did><scopecontent id="aspace_ac2b07265726f24633fb7bfd626b0f46"><head>Scope and Contents</head><p>The series contains material related to the Jackie Robinson: Race, Sports and the American Dream Conference, which was held at Long Island University's Brooklyn campus in April 1997. It includes programs, press releases, brochures, and other printed ephemera, as well as 38 audio cassette tape recordings of the conference.</p></scopecontent><c id="aspace_ref65_fmo" level="file"><did><unittitle>Jackie Robinson Conference audio cassette tapes and ephemera</unittitle><unitid type="aspace_uri">/repositories/3/archival_objects/21943</unitid><unitdate datechar="creation" normal="1997/1997" type="inclusive">1997</unitdate><container altrender="Medium Flat Box 13" id="aspace_b92f37cf1e270b229096b2316b8d279f" label="Mixed Ma